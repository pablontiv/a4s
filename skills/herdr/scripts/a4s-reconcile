#!/usr/bin/env python3
"""a4s-reconcile — deterministic Bead/Herdr reconciler (no LLM, no messages).

Reads durable state from Beads (`bd`) and liveness from Herdr (`herdr`) and
converges them once per tick. Intended executor: launchd/cron, never an agent.

Actions per tick (see skills/herdr/SKILL.md):
  0. MC safety gate      -> discover the canonical Mission Control by owner
                            lease + session identity (never by label alone);
                            absent/duplicated/stale/ambiguous => ATTENTION and
                            NO mutation this tick (actions 1-3 are skipped).
  1. bd ready            -> dispatch the Bead's content to a new peer tab
  2. bd in_progress      -> `herdr agent get <metadata.worker>`
                            working=leave, done=close ONLY on a valid
                            TASK_RESULT record (else WORK_RESULT_MISSING /
                            WORK_RESULT_INVALID ticket, Bead stays open),
                            NOT_FOUND=re-dispatch, blocked=AttentionTicket
                            no metadata.worker: live lease / live agent =>
                            leave; stale lease + no live agent + opt-in label
                            + assignee==actor => re-dispatch in a new tab;
                            otherwise AttentionTicket
  2c. dispatched Bead carrying metadata.correlation_id: read-only TASK_ACK/
                            TASK_STARTED audit (helper/task_ack.py writes the
                            metadata, never this script). No receipt_id after
                            --ack-after => ACK_MISSING; start without ack,
                            ack/start without correlation, or partial fields =>
                            AttentionTicket. Transport acceptance is not an ack.
  2d. dispatched Bead's escalation route (read-only): correlation_id without a
                            valid metadata.orchestrator_target, a Human/MC target,
                            or escalation_delivery=failed|refused evidence left by
                            helper/escalation.py => AttentionTicket.
  2e. harvest gate: `done` proves a process stopped, not a verdict. The Worker records
                            result_id/result_at/result_by/result_verdict/result_artifact_path/
                            result_correlation_id via helper/task_result.py before its final
                            callback. Harvest validates that record (correlation to the current
                            dispatch, closed verdict set, safe artifact path, identity, ack) and
                            closes with the record's exact verdict/artifact. It never parses a
                            terminal transcript and never infers a result from liveness.
  3. bd closed + live tab -> `herdr tab close` (reaper)
  4. blocked / needs-decision / ambiguous -> AttentionTicket (evidence file only)
  5. idempotent: a second tick over unchanged state plans and does nothing.

Safety:
  * DRY-RUN IS THE DEFAULT. Nothing mutates unless --apply is given; in dry-run
    every bd call also runs with --readonly.
  * Herdr server not running -> no-op (exit 0).
  * MC GATE (fail closed) re-checked before every dispatch/close/reap. The
    reconciler NEVER issues a pane/tab/workspace/agent mutation that targets an
    mc-labelled or MC-owned pane, tab, workspace or agent, and its herdr
    mutation vocabulary is an allowlist (tab create|close, agent start|prompt).
    It never creates, moves or relabels an mc pane.
  * MC OWNERSHIP BEAD IS UNTOUCHABLE. The current MC owner Bead, any Bead labelled
    `mission-control`, and any Bead wired to an MC-owned pane/tab/workspace/agent are
    never harvest-closed, re-dispatched, re-stamped, claimed or reaped: they are
    filtered out of actions 1-3 and `mutate()` refuses every bd write aimed at them.
    Only Mission Control / the Operator may change it.
  * WORKER ESCALATION GOES TO THE PO ONLY. Dispatch stamps metadata.orchestrator_target
    (the --callback pane/name) and correlation_id in one bd update before the agent
    starts or is prompted, and fails closed (no claim, no tab, no agent) unless the
    target is a live agent that is not the Worker, Human/Operator, or mc/MC-owned.
    The Worker's prompt forbids asking the Human Operator or Mission Control and
    routes every blocker/question through helper/escalation.py to that target.
  * Fail closed: unknown worker status, identity mismatch, shared tab, missing
    workspace/callback -> no lifecycle mutation, only a report (AttentionTicket
    where evidence is worth keeping).
  * Only touches tabs recorded in a Bead's own metadata. Only claude|pi kinds.
  * Dispatch is opt-in per Bead (label --dispatch-label, default auto-dispatch).
  * bd writes on a claimed Bead run with BEADS_ACTOR=<assignee> because the
    assignee guard rejects another identity.

Only external commands: `bd`, `herdr` (and `git` to locate the repo root).
"""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import time
import uuid
from dataclasses import dataclass

HELPER_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "helper")
sys.path.insert(0, os.path.normpath(HELPER_DIR))
import escalation  # noqa: E402  (orchestrator_target rules shared with the Worker-side router)
import task_ack  # noqa: E402  (envelope grammar + field names shared with the Worker-side recorder)
import task_result  # noqa: E402  (result record + the harvest gate's rule set, shared with the Worker-side recorder)

TASK_ACK_HELPER = os.path.join(os.path.normpath(HELPER_DIR), "task_ack.py")
TASK_RESULT_HELPER = os.path.join(os.path.normpath(HELPER_DIR), "task_result.py")
ESCALATION_HELPER = os.path.join(os.path.normpath(HELPER_DIR), "escalation.py")
A4S_ROOT_DEFAULT = os.path.abspath(os.environ.get("A4S_STATE_ROOT") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "a4s"))
AUDIT_VERSION = "a4s.audit/1"
LOG_VERSION = "a4s.log/1"
AUDIT_OPERATIONS = {
    "bd.update", "bd.close", "herdr.tab.create", "herdr.tab.close",
    "herdr.agent.start", "herdr.agent.prompt",
}
AUDIT_EVENTS = {"intent", "result", "resolution"}
AUDIT_STATUS = {"pending", "applied", "not-applied", "ambiguous"}
AUDIT_CODES = {
    "intent-recorded", "exit-zero", "process-not-created", "exit-nonzero",
    "process-timeout", "process-signal", "execution-exception", "human-resolution",
}
AUDIT_ID_KEYS = {"bead_id", "dispatch_id", "tab_id", "agent_id", "workspace_id", "pane_id"}
AUDIT_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
AUDIT_RECORD_ID_RE = re.compile(r"^[0-9a-f]{32}$")
AUDIT_LINE_MAX = 65536
AUDIT_FILE_MAX = 16 * 1024 * 1024
DISPATCH_TYPES = {"task", "bug", "feature", "chore", "spike"}
ALLOWED_KINDS = {"claude", "pi"}
ACTOR = "a4s-reconcile"
MC_LABEL = "mission-control"  # lookup index for the MC ownership Bead; NOT authority by itself
MC_NAME_RE = re.compile(r"^(mc|mission[-_ ]?control)([-_ .:].*)?$", re.I)
# The only herdr mutations the reconciler may ever issue. Everything else
# (pane split/move/close, workspace *, tab rename/move, ...) is refused.
ALLOWED_HERDR_MUTATIONS = {("tab", "create"), ("tab", "close"), ("agent", "start"), ("agent", "prompt")}
VERDICT_ORDER = ["ABSENT", "DUPLICATED", "AMBIGUOUS", "STALE"]


class Abort(Exception):
    """Snapshot could not be trusted; abort the tick without mutating."""


class StepError(Exception):
    """One Bead's action failed; other Beads continue."""


class GuardViolation(StepError):
    """El gate de MC o una guarda rechazó la mutación."""


class MutationHalt(Exception):
    """El protocolo durable detiene las mutaciones restantes."""


class AuditCorrupt(Exception):
    """El flujo de audit no es válido."""


class AuditRollbackFailed(AuditCorrupt):
    """El rollback del audit no pudo restaurar el tamaño inicial."""


@dataclass(frozen=True)
class BdUpdate:
    bead_id: str
    arguments: tuple
    actor: str = None
    dispatch_id: str = None


@dataclass(frozen=True)
class BdClose:
    bead_id: str
    reason: str
    actor: str = None


@dataclass(frozen=True)
class TabCreate:
    bead_id: str
    dispatch_id: str
    workspace_id: str
    cwd: str
    label: str


@dataclass(frozen=True)
class TabClose:
    bead_id: str
    tab_id: str


@dataclass(frozen=True)
class AgentStart:
    bead_id: str
    dispatch_id: str
    agent_id: str
    pane_id: str
    kind: str
    model: str = None


@dataclass(frozen=True)
class AgentPrompt:
    bead_id: str
    dispatch_id: str
    agent_id: str
    prompt: str


MUTATION_TYPES = (BdUpdate, BdClose, TabCreate, TabClose, AgentStart, AgentPrompt)


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def _lstat(path):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        return None


def secure_dir(path, create):
    """Crea o valida un directorio de persistencia."""
    path = os.path.abspath(path)
    info = _lstat(path)
    created = False
    if info is None:
        if not create:
            return False
        parent = os.path.dirname(path)
        if parent and parent != path and not os.path.exists(parent):
            secure_dir(parent, True)
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
        created = True
        info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise OSError("persistence directory is not a regular directory")
    if stat.S_IMODE(info.st_mode) != 0o700:
        if not create:
            raise OSError("persistence directory mode is not 0700")
        os.chmod(path, 0o700)
    if created:
        parent_fd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    return True


def secure_tree(root, parts, create):
    """Valida cada directorio canónico sin seguir enlaces simbólicos."""
    current = os.path.abspath(root)
    chain = [current]
    for part in parts:
        current = os.path.join(current, part)
        chain.append(current)
    for index, path in enumerate(chain):
        info = _lstat(path)
        created = info is None
        if created:
            if not create:
                return False
            parent = os.path.dirname(path)
            if path == chain[0] and not os.path.isdir(parent):
                secure_dir(parent, True)
            try:
                os.mkdir(path, 0o700)
            except FileExistsError:
                pass
            dfd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
            info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise OSError("persistence directory is not regular")
        if (created or index > 0) and stat.S_IMODE(info.st_mode) != 0o700:
            if not create:
                raise OSError("persistence directory mode is not 0700")
            os.chmod(path, 0o700)
    return True


def secure_open_append(path):
    directory = os.path.dirname(path)
    secure_dir(directory, True)
    before = _lstat(path)
    existed = before is not None
    if before is not None and (stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode)):
        raise OSError("persistence file is not regular")
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode)
            or (before is not None and (before.st_dev, before.st_ino) != (info.st_dev, info.st_ino))):
        os.close(fd)
        raise OSError("persistence file is not regular")
    if stat.S_IMODE(info.st_mode) != 0o600:
        os.fchmod(fd, 0o600)
    return fd, not existed


def append_durable(path, record):
    """Agrega una línea mientras el llamador mantiene el lock exclusivo canónico."""
    raw = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    if len(raw) > AUDIT_LINE_MAX:
        raise OSError("audit record is too large")
    fd, created = secure_open_append(path)
    initial_size = os.fstat(fd).st_size
    try:
        try:
            view = memoryview(raw)
            while view:
                written = os.write(fd, view)
                if written <= 0:
                    raise OSError("short audit write")
                view = view[written:]
            os.fsync(fd)
            if os.fstat(fd).st_size != initial_size + len(raw):
                raise OSError("audit size confirmation failed")
            if created:
                dfd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
                try:
                    os.fsync(dfd)
                finally:
                    os.close(dfd)
        except BaseException as append_error:
            try:
                os.ftruncate(fd, initial_size)
                os.fsync(fd)
                if os.fstat(fd).st_size != initial_size:
                    raise OSError("audit rollback size confirmation failed")
            except BaseException as rollback_error:
                raise AuditRollbackFailed("audit rollback failed") from rollback_error
            raise append_error
    finally:
        os.close(fd)


def append_best_effort(path, record):
    try:
        raw = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
        fd, created = secure_open_append(path)
        try:
            view = memoryview(raw)
            while view:
                written = os.write(fd, view)
                if written <= 0:
                    raise OSError("short log write")
                view = view[written:]
            os.fsync(fd)
        finally:
            os.close(fd)
        if created:
            dfd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
    except Exception:
        return False
    return True


def invalid_json_constant(_value):
    raise AuditCorrupt("invalid JSON constant")


def no_duplicate_object(pairs):
    out = {}
    for key, value in pairs:
        if key in out:
            raise AuditCorrupt("duplicate JSON key")
        out[key] = value
    return out


def validate_audit_record(rec, line_number):
    if not isinstance(rec, dict):
        raise AuditCorrupt("line %d is not an object" % line_number)
    required = {"schema", "record_id", "mutation_id", "event", "utc", "operation", "ids", "status", "code"}
    keys = set(rec)
    if keys not in (required, required | {"scopes"}):
        raise AuditCorrupt("line %d has invalid keys" % line_number)
    enum_values = (rec["schema"], rec["event"], rec["operation"], rec["status"], rec["code"])
    if any(not isinstance(value, str) for value in enum_values):
        raise AuditCorrupt("line %d has invalid enum type" % line_number)
    if rec["schema"] != AUDIT_VERSION or rec["event"] not in AUDIT_EVENTS:
        raise AuditCorrupt("line %d has invalid version or event" % line_number)
    if rec["operation"] not in AUDIT_OPERATIONS or rec["status"] not in AUDIT_STATUS or rec["code"] not in AUDIT_CODES:
        raise AuditCorrupt("line %d has invalid enum" % line_number)
    if (not isinstance(rec["record_id"], str) or not isinstance(rec["mutation_id"], str)
            or not AUDIT_RECORD_ID_RE.fullmatch(rec["record_id"])
            or not AUDIT_RECORD_ID_RE.fullmatch(rec["mutation_id"])):
        raise AuditCorrupt("line %d has invalid record id" % line_number)
    if not isinstance(rec["utc"], str):
        raise AuditCorrupt("line %d has invalid UTC type" % line_number)
    try:
        parsed = datetime.datetime.fromisoformat(rec["utc"].replace("Z", "+00:00"))
    except ValueError:
        raise AuditCorrupt("line %d has invalid UTC" % line_number)
    if parsed.tzinfo is None or parsed.utcoffset() != datetime.timedelta(0) or not rec["utc"].endswith("Z"):
        raise AuditCorrupt("line %d has non-UTC timestamp" % line_number)
    ids = rec["ids"]
    if not isinstance(ids, dict) or not ids or not set(ids).issubset(AUDIT_ID_KEYS):
        raise AuditCorrupt("line %d has invalid semantic IDs" % line_number)
    if any(not isinstance(v, str) or not AUDIT_ID_RE.fullmatch(v) for v in ids.values()):
        raise AuditCorrupt("line %d has invalid semantic ID value" % line_number)
    required_ids = {
        "bd.update": ({"bead_id"}, {"bead_id", "dispatch_id"}),
        "bd.close": ({"bead_id"}, {"bead_id"}),
        "herdr.tab.create": ({"bead_id", "dispatch_id", "workspace_id"},
                              {"bead_id", "dispatch_id", "workspace_id"}),
        "herdr.tab.close": ({"bead_id", "tab_id"}, {"bead_id", "tab_id"}),
        "herdr.agent.start": ({"bead_id", "dispatch_id", "agent_id", "pane_id"},
                              {"bead_id", "dispatch_id", "agent_id", "pane_id"}),
        "herdr.agent.prompt": ({"bead_id", "dispatch_id", "agent_id"},
                               {"bead_id", "dispatch_id", "agent_id"}),
    }[rec["operation"]]
    if not required_ids[0].issubset(ids) or not set(ids).issubset(required_ids[1]):
        raise AuditCorrupt("line %d has invalid IDs for its operation" % line_number)
    scopes = rec.get("scopes")
    if scopes is not None:
        if not isinstance(scopes, list) or not scopes or any(not isinstance(x, str) for x in scopes):
            raise AuditCorrupt("line %d has invalid scopes" % line_number)
        if (len(scopes) != len(set(scopes)) or scopes != sorted(scopes)
                or any(not re.fullmatch(r"(?:bead|dispatch|tab|agent):[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", x) for x in scopes)):
            raise AuditCorrupt("line %d has invalid scope value" % line_number)
        expected_scopes = {"bead:%s" % ids["bead_id"]}
        if "dispatch_id" in ids:
            expected_scopes.add("dispatch:%s" % ids["dispatch_id"])
        if "tab_id" in ids:
            expected_scopes.add("tab:%s" % ids["tab_id"])
        if "agent_id" in ids:
            expected_scopes.add("agent:%s" % ids["agent_id"])
        if set(scopes) != expected_scopes:
            raise AuditCorrupt("line %d has scopes that do not match IDs" % line_number)
    expected = {
        "intent": ("pending", "intent-recorded"),
        "resolution": (("applied", "not-applied"), "human-resolution"),
    }
    if rec["event"] == "intent" and (rec["status"], rec["code"]) != expected["intent"]:
        raise AuditCorrupt("line %d has invalid intent state" % line_number)
    if rec["event"] == "resolution" and (rec["status"] not in expected["resolution"][0] or rec["code"] != "human-resolution"):
        raise AuditCorrupt("line %d has invalid resolution state" % line_number)
    valid_results = {
        ("applied", "exit-zero"), ("not-applied", "process-not-created"),
        ("ambiguous", "exit-nonzero"), ("ambiguous", "process-timeout"),
        ("ambiguous", "process-signal"), ("ambiguous", "execution-exception"),
    }
    if rec["event"] == "result" and (rec["status"], rec["code"]) not in valid_results:
        raise AuditCorrupt("line %d has invalid result state" % line_number)
    return rec


def read_audit(path):
    info = _lstat(path)
    if info is None:
        return {"records": [], "mutations": {}, "global_block": False}
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
        raise AuditCorrupt("audit file is not a regular 0600 file")
    if info.st_size > AUDIT_FILE_MAX:
        raise AuditCorrupt("audit file is too large")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        raise AuditCorrupt("audit file could not be opened safely")
    try:
        opened = os.fstat(fd)
        if ((opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino)
                or not stat.S_ISREG(opened.st_mode) or stat.S_IMODE(opened.st_mode) != 0o600):
            raise AuditCorrupt("audit file changed while opening")
        chunks = []
        remaining = AUDIT_FILE_MAX + 1
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
    finally:
        os.close(fd)
    if len(raw) > AUDIT_FILE_MAX:
        raise AuditCorrupt("audit file is too large")
    if raw and not raw.endswith(b"\n"):
        raise AuditCorrupt("audit file has a truncated final line")
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeDecodeError:
        raise AuditCorrupt("audit file is not UTF-8")
    records = []
    mutations = {}
    global_block = False
    seen_record_ids = set()
    for number, line in enumerate(text.splitlines(), 1):
        if not line or len(line.encode("utf-8")) + 1 > AUDIT_LINE_MAX:
            raise AuditCorrupt("line %d has invalid size" % number)
        try:
            rec = json.loads(line, object_pairs_hook=no_duplicate_object, parse_constant=invalid_json_constant)
        except (ValueError, AuditCorrupt):
            raise AuditCorrupt("line %d is invalid JSON" % number)
        validate_audit_record(rec, number)
        if rec["record_id"] in seen_record_ids:
            raise AuditCorrupt("line %d repeats a record id" % number)
        seen_record_ids.add(rec["record_id"])
        mutation = mutations.get(rec["mutation_id"])
        if rec["event"] == "intent":
            if mutation is not None:
                raise AuditCorrupt("line %d repeats an intent" % number)
            mutation = {"intent": rec, "result": None, "resolution": None}
            mutations[rec["mutation_id"]] = mutation
        else:
            if mutation is None:
                raise AuditCorrupt("line %d precedes its intent" % number)
            intent = mutation["intent"]
            if rec["operation"] != intent["operation"] or rec["ids"] != intent["ids"] or rec.get("scopes") != intent.get("scopes"):
                raise AuditCorrupt("line %d does not match its intent" % number)
            if rec["event"] == "result":
                if mutation["result"] is not None or mutation["resolution"] is not None:
                    raise AuditCorrupt("line %d repeats or follows closure" % number)
                mutation["result"] = rec
            else:
                current = mutation["result"]
                if mutation["resolution"] is not None or (current and current["status"] != "ambiguous"):
                    raise AuditCorrupt("line %d resolves a closed mutation" % number)
                mutation["resolution"] = rec
        records.append(rec)
    global_block = any("scopes" not in mutation["intent"] and mutation_state(mutation) in ("pending", "ambiguous")
                       for mutation in mutations.values())
    return {"records": records, "mutations": mutations, "global_block": global_block}


def mutation_state(mutation):
    if mutation["resolution"]:
        return mutation["resolution"]["status"]
    if mutation["result"]:
        return mutation["result"]["status"]
    return "pending"


class Ctx:
    def __init__(self, args):
        self.apply = args.apply
        self.repo = args.repo
        self.root = getattr(args, "root", getattr(args, "state_dir", A4S_ROOT_DEFAULT))
        self.state = os.path.join(self.root, "state", "reconcile")
        self.audit_path = os.path.join(self.root, "audit", "reconcile", "audit.jsonl")
        self.log_path = os.path.join(self.root, "log", "reconcile", "events.jsonl")
        self.lock_path = os.path.join(self.state, "tick.lock")
        self.callback = args.callback
        self.dispatch_label = args.dispatch_label
        self.settle = args.settle
        self.reap_grace = args.reap_grace
        self.max_redispatch = args.max_redispatch
        self.max_dispatch = args.max_dispatch
        self.default_kind = args.default_kind
        self.default_model = args.default_model
        self.stale_after = args.stale_after
        self.ack_after = args.ack_after
        self.mc_grace = args.mc_grace
        self.plan_ungated = args.plan_ignoring_mc_gate
        self.bd_bin = os.environ.get("A4S_BD", "bd")
        self.herdr_bin = os.environ.get("A4S_HERDR", "herdr")
        self.self_tab = os.environ.get("HERDR_TAB_ID", "")
        self.actions = []
        self.errors = 0
        self.agents = {}
        self.tabs = {}
        self.busy_tabs = {}
        self.new_names = set()
        self.panes = {}
        self.workspaces = {}
        self.mc_beads = []
        self.bead_index = {}
        self.gate = {"verdict": "UNEVALUATED", "reasons": ["gate not evaluated"], "owner": None}
        self.protected = {"workspaces": set(), "tabs": set(), "panes": set(), "agents": set()}
        self.dispatched = 0
        self._actor = None
        self.audit_view = {"records": [], "mutations": {}, "global_block": False}
        self.tick_id = uuid.uuid4().hex

    def log(self, event, status, **fields):
        if not self.apply:
            return False
        record = {"schema": LOG_VERSION, "timestamp": utc_now(), "severity_text": "INFO", "severity_number": 9,
                  "event_name": event, "body": event, "resource.service.name": "a4s-reconcile",
                  "scope.name": "a4s.reconcile", "attributes.a4s.operation_id": self.tick_id,
                  "attributes.a4s.operation": event, "attributes.a4s.status": status}
        for key, value in fields.items():
            record["attributes.a4s.%s" % key] = value
        try:
            secure_tree(self.root, ("log", "reconcile"), True)
        except Exception:
            return False
        return append_best_effort(self.log_path, record)


def run(argv, cwd=None, timeout=120, env=None):
    try:
        p = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def parse_json(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


def bd(ctx, *a, timeout=120):
    argv = [ctx.bd_bin]
    if not ctx.apply:
        argv.append("--readonly")
    return run(argv + list(a), cwd=ctx.repo, timeout=timeout)


def bd_json(ctx, *a):
    rc, out, err = bd(ctx, *a, "--json")
    data = parse_json(out) if rc == 0 else None
    if data is None:
        raise Abort("bd %s failed rc=%s: %s" % (" ".join(a), rc, err.strip()[:200]))
    return data


def herdr(ctx, *a, timeout=120):
    return run([ctx.herdr_bin] + list(a), timeout=timeout)


def herdr_result(ctx, *a):
    rc, out, err = herdr(ctx, *a)
    data = parse_json(out) or parse_json(err) or {}
    return rc, data


def emit(ctx, kind, bead, msg, mutating=False):
    tag = "APPLY" if (ctx.apply and mutating) else ("PLAN " if mutating else "INFO ")
    line = "%s %-10s %-12s %s" % (tag, kind, bead or "-", msg)
    print(line)
    ctx.actions.append({"kind": kind, "bead": bead, "msg": msg, "mutating": mutating,
                        "applied": bool(ctx.apply and mutating)})


def opt(argv, flag):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else None


def guard_herdr(ctx, argv):
    """Refuse any herdr mutation outside the allowlist or aimed at a protected (mc/MC-owned) target."""
    verb = tuple(argv[:2])
    if verb not in ALLOWED_HERDR_MUTATIONS:
        raise GuardViolation("herdr %s is not an allowed reconciler mutation (allowlist: %s)" % (
            " ".join(argv[:2]), ", ".join(" ".join(v) for v in sorted(ALLOWED_HERDR_MUTATIONS))))
    pr = ctx.protected
    if verb == ("tab", "create"):
        guard_workspace(ctx, opt(argv, "--workspace"))
        if MC_NAME_RE.match(opt(argv, "--label") or ""):
            raise GuardViolation("refusing to create an mc-labelled tab")
    elif verb == ("tab", "close"):
        if len(argv) < 3 or argv[2] in pr["tabs"]:
            raise GuardViolation("tab %s is mc/MC-owned or a protected workspace's tab" % (argv[2:3] or ["?"])[0])
    elif verb == ("agent", "start"):
        pane = opt(argv, "--pane")
        if (pane in pr["panes"] or ctx.panes.get(pane, {}).get("tab_id") in pr["tabs"]
                or (len(argv) > 2 and argv[2] in pr["agents"])):
            raise GuardViolation("agent start targets protected pane %s / agent %s" % (pane, argv[2:3]))
    elif verb == ("agent", "prompt"):
        tgt = argv[2] if len(argv) > 2 else None
        a = ctx.agents.get(tgt) or {}
        if (tgt in pr["agents"] or tgt in pr["panes"] or a.get("pane_id") in pr["panes"]
                or a.get("tab_id") in pr["tabs"]):
            raise GuardViolation("agent prompt targets protected agent/pane %s" % tgt)


def guard_bd(ctx, argv):
    """Refuse any bd write (update/close/...) aimed at the MC ownership Bead or a Bead wired to MC."""
    if len(argv) > 1:
        b = ctx.bead_index.get(argv[1]) or {"id": argv[1]}
        why = mc_owned(ctx, b)
        if why:
            raise GuardViolation("bd %s %s refused: MC ownership Bead (%s)" % (argv[0], argv[1], why))


def refuse_mc_bead(ctx, b):
    why = mc_owned(ctx, b)
    if why:
        raise GuardViolation("Bead %s is an MC ownership Bead (%s): the reconciler never mutates it" % (b["id"], why))


def guard_workspace(ctx, ws):
    if ws in ctx.protected["workspaces"]:
        raise GuardViolation("workspace %s is the Mission Control workspace (protected)" % ws)


def bd_actor(ctx, b):
    """Ejecuta bd con la identidad que exige su guarda."""
    if ctx._actor is None:
        ctx._actor = os.environ.get("BEADS_ACTOR") or run(["git", "config", "user.name"], cwd=ctx.repo)[1].strip()
    return (b or {}).get("assignee") or ctx._actor


def describe_mutation(change):
    if not isinstance(change, MUTATION_TYPES):
        raise TypeError("mutate requires a typed mutation descriptor")
    if isinstance(change, BdUpdate):
        operation = "bd.update"
        ids = {"bead_id": change.bead_id}
        if change.dispatch_id:
            ids["dispatch_id"] = change.dispatch_id
        scopes = ["bead:%s" % change.bead_id]
        if change.dispatch_id:
            scopes.append("dispatch:%s" % change.dispatch_id)
        argv = ["update", change.bead_id] + list(change.arguments)
        return operation, ids, sorted(scopes), "bd", argv, change.actor
    if isinstance(change, BdClose):
        return "bd.close", {"bead_id": change.bead_id}, ["bead:%s" % change.bead_id], "bd", [
            "close", change.bead_id, "--reason", change.reason], change.actor
    if isinstance(change, TabCreate):
        ids = {"bead_id": change.bead_id, "dispatch_id": change.dispatch_id,
               "workspace_id": change.workspace_id}
        scopes = sorted(["bead:%s" % change.bead_id, "dispatch:%s" % change.dispatch_id])
        argv = ["tab", "create", "--workspace", change.workspace_id, "--cwd", change.cwd,
                "--label", change.label, "--no-focus"]
        return "herdr.tab.create", ids, scopes, "herdr", argv, None
    if isinstance(change, TabClose):
        ids = {"bead_id": change.bead_id, "tab_id": change.tab_id}
        scopes = sorted(["bead:%s" % change.bead_id, "tab:%s" % change.tab_id])
        return "herdr.tab.close", ids, scopes, "herdr", ["tab", "close", change.tab_id], None
    if isinstance(change, AgentStart):
        ids = {"bead_id": change.bead_id, "dispatch_id": change.dispatch_id,
               "agent_id": change.agent_id, "pane_id": change.pane_id}
        scopes = sorted(["bead:%s" % change.bead_id, "dispatch:%s" % change.dispatch_id,
                         "agent:%s" % change.agent_id])
        argv = ["agent", "start", change.agent_id, "--kind", change.kind, "--pane", change.pane_id]
        if change.model:
            argv += ["--", "--model", str(change.model)]
        return "herdr.agent.start", ids, scopes, "herdr", argv, None
    ids = {"bead_id": change.bead_id, "dispatch_id": change.dispatch_id, "agent_id": change.agent_id}
    scopes = sorted(["bead:%s" % change.bead_id, "dispatch:%s" % change.dispatch_id,
                     "agent:%s" % change.agent_id])
    return "herdr.agent.prompt", ids, scopes, "herdr", ["agent", "prompt", change.agent_id, change.prompt], None


def validate_descriptor(change, operation, ids, argv, ctx):
    for value in ids.values():
        if not isinstance(value, str) or not AUDIT_ID_RE.fullmatch(value):
            raise GuardViolation("mutation has an invalid semantic ID")
    if operation.startswith("herdr."):
        guard_herdr(ctx, argv)
    else:
        guard_bd(ctx, argv)
    if isinstance(change, BdUpdate) and (not change.arguments or change.arguments[0] not in ("--claim", "--set-metadata")):
        raise GuardViolation("bd update descriptor has invalid arguments")
    if isinstance(change, AgentStart) and change.kind not in ALLOWED_KINDS:
        raise GuardViolation("agent kind is not allowed")


def audit_record(mutation_id, event, operation, ids, scopes, status, code):
    record = {"schema": AUDIT_VERSION, "record_id": uuid.uuid4().hex, "mutation_id": mutation_id,
              "event": event, "utc": utc_now(), "operation": operation, "ids": ids,
              "status": status, "code": code}
    if scopes is not None:
        record["scopes"] = scopes
    return record


def open_audit_conflict(view, scopes):
    if view["global_block"]:
        return "legacy audit record without scopes"
    wanted = set(scopes)
    for mutation_id, mutation in view["mutations"].items():
        state = mutation_state(mutation)
        if state in ("pending", "ambiguous") and wanted.intersection(mutation["intent"].get("scopes", [])):
            return "%s mutation %s" % (state, mutation_id)
    return None


def record_audit(ctx, record):
    secure_tree(ctx.root, ("audit", "reconcile"), True)
    append_durable(ctx.audit_path, record)
    ctx.audit_view = read_audit(ctx.audit_path)


def run_process(argv, cwd=None, env=None, timeout=120):
    """Inicia un proceso y conserva el estado de creación."""
    try:
        process = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except Exception as exc:
        return "not-started", None, "", "", exc
    try:
        out, err = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        try:
            process.kill()
            out, err = process.communicate()
        except Exception:
            out, err = "", ""
        return "timeout", process.returncode, out, err, exc
    except Exception as exc:
        try:
            process.kill()
            out, err = process.communicate()
        except Exception:
            out, err = "", ""
        return "exception", process.returncode, out, err, exc
    return "exited", process.returncode, out, err, None


def mutate(ctx, change):
    """Aplica una mutación tipada con el protocolo durable."""
    operation, ids, scopes, tool, argv, actor = describe_mutation(change)
    if ctx.gate["verdict"] != "OK" and not ctx.plan_ungated:
        raise GuardViolation("MC gate is %s; mutations are disabled" % ctx.gate["verdict"])
    validate_descriptor(change, operation, ids, argv, ctx)
    conflict = open_audit_conflict(ctx.audit_view, scopes)
    if conflict:
        raise StepError("audit blocks mutation scope: %s" % conflict)
    if not ctx.apply:
        print("      would run: %s%s" % ("BEADS_ACTOR=%s " % shell_quote(actor) if actor else "",
                                         " ".join(shell_quote(clip(x)) for x in [tool] + argv)))
        return 0, "", ""
    mutation_id = uuid.uuid4().hex
    intent = audit_record(mutation_id, "intent", operation, ids, scopes, "pending", "intent-recorded")
    try:
        record_audit(ctx, intent)
    except Exception as exc:
        raise MutationHalt("intent audit failed before process start: %s" % type(exc).__name__)
    env = dict(os.environ, BEADS_ACTOR=actor) if tool == "bd" and actor else None
    command = ([ctx.bd_bin] if tool == "bd" else [ctx.herdr_bin]) + argv
    cwd = ctx.repo if tool == "bd" else None
    state, rc, out, err, exc = run_process(command, cwd=cwd, env=env)
    if state == "not-started":
        status, code = "not-applied", "process-not-created"
    elif state == "timeout":
        status, code = "ambiguous", "process-timeout"
    elif state == "exception":
        status, code = "ambiguous", "execution-exception"
    elif rc == 0:
        status, code = "applied", "exit-zero"
    elif rc is not None and rc < 0:
        status, code = "ambiguous", "process-signal"
    else:
        status, code = "ambiguous", "exit-nonzero"
    result = audit_record(mutation_id, "result", operation, ids, scopes, status, code)
    try:
        record_audit(ctx, result)
    except Exception as audit_exc:
        raise MutationHalt("result audit failed after process start: %s" % type(audit_exc).__name__)
    ctx.log("mutation.result", status, operation=operation, code=code, mutation_id=mutation_id)
    if status == "ambiguous":
        raise MutationHalt("mutation result is ambiguous: %s" % code)
    if status == "not-applied":
        raise StepError("%s process was not created" % operation)
    return rc, out, err


def clip(s, n=160):
    s = str(s)
    return s if len(s) <= n else "%s...[%d chars]" % (s[:n].replace("\n", " "), len(s))


def shell_quote(s):
    s = str(s)
    return s if re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", s) else "'" + s.replace("'", "'\\''") + "'"


def meta(b):
    m = b.get("metadata")
    return m if isinstance(m, dict) else {}


def labels(b):
    return set(b.get("labels") or [])


# --------------------------------------------------------------------------
# AttentionTicket: evidence-only file, never mutates Bead/Herdr lifecycle.
# --------------------------------------------------------------------------
def attention(ctx, b, kind, facts, evidence_fn=None):
    bead = b["id"]
    digest = hashlib.sha256(json.dumps([bead, kind, facts], sort_keys=True).encode()).hexdigest()[:8]
    path = os.path.join(ctx.state, "attention", "%s--%s--%s.md" % (bead, kind, digest))
    existing = _lstat(path)
    if existing is not None:
        if (stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode)
                or stat.S_IMODE(existing.st_mode) != 0o600):
            raise StepError("AttentionTicket target is not a regular 0600 file")
        emit(ctx, "ATTENTION", bead, "%s already ticketed %s" % (kind, path))
        ctx.log("attention.result", "existing", kind=kind, bead_id=bead)
        return
    emit(ctx, "ATTENTION", bead, "%s evidence-only ticket -> %s" % (kind, path), mutating=True)
    if not ctx.apply:
        return
    evidence = ""
    if evidence_fn:
        try:
            evidence = evidence_fn()
        except StepError as e:
            evidence = "(evidence unavailable: %s)" % e
    secure_tree(ctx.root, ("state", "reconcile", "attention"), True)
    body = ["---", "bead_id: %s" % bead, "kind: %s" % kind,
            "detected_at: %s" % time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "facts: %s" % json.dumps(facts, sort_keys=True), "lifecycle_mutation: none", "---", "",
            "# AttentionTicket %s %s" % (bead, kind), "", "Title: %s" % b.get("title", ""), "",
            "Evidence-only. The reconciler changed no Bead, tab, or agent state.", "",
            "## Evidence", "", "```", evidence.rstrip(), "```", ""]
    tmp = path + ".tmp.%s" % uuid.uuid4().hex
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        view = memoryview("\n".join(body).encode("utf-8"))
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("short AttentionTicket write")
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    dfd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
    ctx.log("attention.result", "created", kind=kind, bead_id=bead)


def read_agent(ctx, worker, source="recent-unwrapped", lines=60):
    rc, out, err = herdr(ctx, "agent", "read", worker, "--source", source, "--lines", str(lines))
    if rc != 0:
        raise StepError("agent read %s failed: %s" % (worker, (err or out).strip()[:200]))
    return out


# --------------------------------------------------------------------------
# Snapshot
# --------------------------------------------------------------------------
def herdr_running(ctx):
    rc, out, err = herdr(ctx, "status", "server", timeout=15)
    return rc == 0 and re.search(r"^status:\s*running\s*$", out, re.M) is not None


def read_herdr_state(ctx):
    """Fresh read-only herdr view (agents, tabs, panes, workspaces) + MC ownership Beads."""
    rc, data = herdr_result(ctx, "agent", "list")
    if rc != 0 or "result" not in data:
        raise Abort("herdr agent list failed")
    agents = {a["name"]: a for a in data["result"].get("agents", []) if a.get("name")}
    rc, data = herdr_result(ctx, "tab", "list")
    if rc != 0 or "result" not in data:
        raise Abort("herdr tab list failed")
    tabs = {t["tab_id"]: t for t in data["result"].get("tabs", [])}
    rc, data = herdr_result(ctx, "pane", "list")
    if rc != 0 or "result" not in data:
        raise Abort("herdr pane list failed")
    panes = {p["pane_id"]: p for p in data["result"].get("panes", [])}
    rc, data = herdr_result(ctx, "workspace", "list")
    if rc != 0 or "result" not in data:
        raise Abort("herdr workspace list failed")
    workspaces = {w["workspace_id"]: w for w in data["result"].get("workspaces", [])}
    mc_beads = bd_json(ctx, "list", "--label", MC_LABEL, "--status", "in_progress", "--limit", "0")
    ctx.agents, ctx.tabs, ctx.panes, ctx.workspaces, ctx.mc_beads = agents, tabs, panes, workspaces, mc_beads


def snapshot(ctx):
    read_herdr_state(ctx)
    evaluate_gate(ctx)
    ctx.in_progress = bd_json(ctx, "list", "--status", "in_progress", "--limit", "0")
    ctx.ready = bd_json(ctx, "ready", "--limit", "0")
    ctx.attn = bd_json(ctx, "list", "--status", "blocked", "--limit", "0")
    ctx.attn += bd_json(ctx, "list", "--label-any", "needs-decision", "--status",
                        "open,in_progress,blocked", "--limit", "0")
    ctx.closed = bd_json(ctx, "list", "--status", "closed", "--has-metadata-key", "tab", "--limit", "0")
    live = bd_json(ctx, "list", "--status", "open,in_progress,blocked", "--has-metadata-key", "tab", "--limit", "0")
    for b in live:
        for t in tab_ids(b):
            ctx.busy_tabs.setdefault(t, set()).add(b["id"])
    for group in (ctx.mc_beads, live, ctx.closed, ctx.attn, ctx.ready, ctx.in_progress):
        for b in group:
            ctx.bead_index[b["id"]] = b


# --------------------------------------------------------------------------
# Action 0: Mission Control safety gate (bead a4s-t9p).
#
# Canonical MC = the ONE in_progress Bead labelled `mission-control` (the label
# is only a lookup index) whose lease is live AND whose recorded session
# identity (metadata.terminal_id and/or metadata.session, plus pane/tab/
# workspace) matches the live herdr pane. A pane/tab/workspace merely LABELLED
# mc / mission-control is a claimant, never an owner. Any other outcome closes
# the gate: ATTENTION, zero mutations, no auto-resolution.
# --------------------------------------------------------------------------
def ts(s):
    if not s:
        return None
    try:
        return iso_epoch(str(s))
    except (ValueError, TypeError):
        return None


def pane_session(p):
    return ((p or {}).get("agent_session") or {}).get("value")


def evaluate_gate(ctx):
    issues = []  # (verdict, reason)
    ws_claims = sorted(w["workspace_id"] for w in ctx.workspaces.values() if MC_NAME_RE.match(w.get("label") or ""))
    tab_claims = sorted(t["tab_id"] for t in ctx.tabs.values() if MC_NAME_RE.match(t.get("label") or ""))
    owner = None
    if not ctx.mc_beads:
        issues.append(("ABSENT", "no in_progress Bead labelled %s holds the MC lease; label-only claimants "
                                 "(workspaces=%s tabs=%s) are not ownership" % (MC_LABEL, ws_claims, tab_claims)))
    elif len(ctx.mc_beads) > 1:
        issues.append(("DUPLICATED", "%d in_progress MC ownership Beads: %s" % (
            len(ctx.mc_beads), ",".join(sorted(b["id"] for b in ctx.mc_beads)))))
    else:
        b = ctx.mc_beads[0]
        m = meta(b)
        owner = {"bead": b["id"], "pane": m.get("pane"), "tab": m.get("tab"), "workspace": m.get("workspace"),
                 "terminal_id": m.get("terminal_id"), "session": m.get("session")}
        missing = [k for k in ("pane", "tab", "workspace") if not m.get(k)]
        if not (m.get("terminal_id") or m.get("session")):
            missing.append("terminal_id|session")
        if missing:
            issues.append(("AMBIGUOUS", "MC Bead %s lacks identity metadata: %s" % (b["id"], ",".join(missing))))
        exp = ts(b.get("lease_expires_at"))
        if exp is None:
            issues.append(("STALE", "MC Bead %s has no parseable lease_expires_at" % b["id"]))
        elif time.time() > exp + ctx.mc_grace:
            issues.append(("STALE", "MC Bead %s lease expired beyond %ss grace (lease_expires_at=%s)" % (
                b["id"], ctx.mc_grace, b.get("lease_expires_at"))))
        pane = ctx.panes.get(m.get("pane"))
        if not missing:
            if pane is None or not pane.get("agent"):
                issues.append(("STALE", "MC owner pane %s is not a live agent pane" % m.get("pane")))
            else:
                bad = []
                if pane.get("tab_id") != m.get("tab"):
                    bad.append("tab %s != recorded %s" % (pane.get("tab_id"), m.get("tab")))
                if pane.get("workspace_id") != m.get("workspace"):
                    bad.append("workspace %s != recorded %s" % (pane.get("workspace_id"), m.get("workspace")))
                if m.get("terminal_id") and pane.get("terminal_id") != m.get("terminal_id"):
                    bad.append("terminal_id %s != recorded %s" % (pane.get("terminal_id"), m.get("terminal_id")))
                if m.get("session") and pane_session(pane) != m.get("session"):
                    bad.append("session identity differs from recorded")
                if bad:
                    issues.append(("AMBIGUOUS", "MC owner pane %s identity mismatch: %s" % (m.get("pane"), "; ".join(bad))))
            others_t = [t for t in tab_claims if t != m.get("tab")]
            others_w = [w for w in ws_claims if w != m.get("workspace")]
            if others_t or others_w:
                issues.append(("DUPLICATED", "label-only MC claimants besides the owner: tabs=%s workspaces=%s" % (
                    others_t, others_w)))
    verdict = "OK"
    if issues:
        verdict = sorted((v for v, _ in issues), key=VERDICT_ORDER.index)[0]
    ctx.gate = {"verdict": verdict, "reasons": sorted(r for v, r in issues), "owner": owner if verdict == "OK" else None}
    compute_protected(ctx, owner)
    return verdict == "OK"


def compute_protected(ctx, owner):
    """Everything the reconciler must never mutate: mc-labelled/MC-owned panes, tabs, workspaces, agents."""
    ws = {w["workspace_id"] for w in ctx.workspaces.values() if MC_NAME_RE.match(w.get("label") or "")}
    tabs = {t["tab_id"] for t in ctx.tabs.values()
            if MC_NAME_RE.match(t.get("label") or "") or t.get("workspace_id") in ws}
    if owner:
        ws.add(owner.get("workspace"))
        tabs.add(owner.get("tab"))
    panes = {pid for pid, p in ctx.panes.items() if p.get("tab_id") in tabs or p.get("workspace_id") in ws}
    if owner:
        panes.add(owner.get("pane"))
    agents = {n for n, a in ctx.agents.items() if a.get("pane_id") in panes or a.get("tab_id") in tabs}
    ctx.protected = {"workspaces": {w for w in ws if w}, "tabs": {t for t in tabs if t},
                     "panes": {p for p in panes if p}, "agents": agents}


def mc_owned(ctx, b):
    """Why Bead `b` is (or is wired to) Mission Control's ownership, else None. Identity, not just the label:
    the current owner Bead(s), anything labelled mission-control (incl. non-in_progress ones), and any Bead whose
    worker/pane/tab/workspace metadata points at an mc-labelled or MC-owned target. Fail closed: over-matching
    only suppresses reconciler action, never causes it."""
    m, pr = meta(b), ctx.protected
    if b.get("id") in {x.get("id") for x in ctx.mc_beads}:
        return "current MC owner"
    if MC_LABEL in labels(b):
        return "labelled %s" % MC_LABEL
    workers = ([str(m["worker"])] if m.get("worker") else []) + [x for x in str(m.get("prev_workers", "")).split(",") if x]
    for w in workers:
        if w in pr["agents"] or MC_NAME_RE.match(w):
            return "metadata.worker=%s is an MC agent" % w
    for key, protected in (("pane", pr["panes"]), ("workspace", pr["workspaces"])):
        if m.get(key) and str(m[key]) in protected:
            return "metadata.%s=%s is MC-owned" % (key, m[key])
    for t in tab_ids(b):
        if t in pr["tabs"]:
            return "metadata tab %s is MC-owned" % t
    return None


def gate_ticket(ctx):
    facts = {"verdict": ctx.gate["verdict"], "reasons": ctx.gate["reasons"]}
    attention(ctx, {"id": "mission-control", "title": "Mission Control ownership gate"},
              "MC_GATE_%s" % ctx.gate["verdict"], facts,
              lambda: "\n".join(["verdict=%s" % ctx.gate["verdict"]] + ctx.gate["reasons"] + [
                  "protected panes=%s tabs=%s workspaces=%s" % tuple(
                      sorted(ctx.protected[k]) for k in ("panes", "tabs", "workspaces")),
                  "No dispatch/recovery/close/reap ran. Operator/MC must resolve ownership; the reconciler never does."]))


def recheck_gate(ctx):
    """Fresh re-evaluation right before a mutation batch (TOCTOU). True = gate open."""
    if ctx.plan_ungated:
        return True
    try:
        read_herdr_state(ctx)
    except Abort as e:
        ctx.gate = {"verdict": "AMBIGUOUS", "reasons": ["MC re-check failed: %s" % e], "owner": None}
    else:
        evaluate_gate(ctx)
    if ctx.gate["verdict"] == "OK":
        return True
    emit(ctx, "MC-GATE", None, "CLOSED (%s) at re-check; aborting mutations this tick" % ctx.gate["verdict"])
    gate_ticket(ctx)
    return False


def tab_ids(b):
    m = meta(b)
    out = []
    if m.get("tab"):
        out.append(str(m["tab"]))
    out += [t for t in str(m.get("prev_tabs", "")).split(",") if t]
    return out


# --------------------------------------------------------------------------
# Action 2: in_progress
# --------------------------------------------------------------------------
def get_worker(ctx, name):
    """-> ('found', agent) | ('not_found', None) | ('error', msg)"""
    rc, data = herdr_result(ctx, "agent", "get", name)
    if rc == 0 and "result" in data:
        return "found", data["result"].get("agent") or {}
    code = (data.get("error") or {}).get("code")
    if code == "agent_not_found":
        return "not_found", None
    return "error", "agent get %s rc=%s %s" % (name, rc, json.dumps(data)[:200])


def reconcile_in_progress(ctx):
    for b in ctx.in_progress:
        bead, m = b["id"], meta(b)
        if b.get("issue_type") == "epic":
            continue
        why = mc_owned(ctx, b)
        if why:
            emit(ctx, "LEAVE", bead, "MC ownership Bead (%s): never harvested, re-dispatched, re-stamped or closed" % why)
            continue
        audit_escalation(ctx, b)
        if not check_ack_protocol(ctx, b):
            continue
        worker = m.get("worker")
        if not worker:
            try:
                unlinked(ctx, b)
            except StepError as e:
                ctx.errors += 1
                emit(ctx, "ERROR", bead, str(e))
            continue
        try:
            state, info = get_worker(ctx, str(worker))
            settling = ctx_settling(ctx, m)
            if state == "error":
                emit(ctx, "SKIP", bead, "ambiguous: %s" % info)
            elif state == "not_found":
                if settling:
                    emit(ctx, "LEAVE", bead, "worker %s not found but dispatched <%ss ago (settling)" % (worker, ctx.settle))
                else:
                    ghost(ctx, b, worker)
            else:
                handle_status(ctx, b, worker, info, settling)
        except StepError as e:
            ctx.errors += 1
            emit(ctx, "ERROR", bead, str(e))


def mc_identities(ctx):
    """Every pane/tab/agent name the escalation route must never point at."""
    pr = ctx.protected
    ids = set(pr["panes"]) | set(pr["tabs"]) | set(pr["agents"])
    for b in ctx.mc_beads:
        ids |= {str(meta(b)[k]) for k in ("pane", "tab", "worker", "terminal_id") if meta(b).get(k)}
    return ids


def orchestrator_target_problem(ctx, target, worker=None):
    """-> (code, detail) when `target` may not receive Worker escalations, else None. Dispatch-time rule: the static
    rules shared with the Worker's router, then live resolution to exactly the agent the PO runs as."""
    problem = escalation.check_target(target, mc_identities(ctx), {worker} if worker else ())
    if problem:
        return problem
    agent = ctx.agents.get(target) or next((a for a in ctx.agents.values() if a.get("pane_id") == target), None)
    if agent is None:
        return "TARGET_NOT_LIVE", "orchestrator_target %r is not a live agent name or pane id" % target
    pr = ctx.protected
    if agent.get("name") in pr["agents"] or agent.get("pane_id") in pr["panes"] or agent.get("tab_id") in pr["tabs"]:
        return "TARGET_FORBIDDEN", "orchestrator_target %r resolves to a Mission Control-owned agent" % target
    return None


def audit_escalation(ctx, b):
    """Read-only audit of a dispatched Bead's escalation route. Evidence-only tickets; never writes, never re-routes."""
    bead, m = b["id"], meta(b)
    corr, target = m.get("correlation_id"), m.get("orchestrator_target")
    if m.get("escalation_delivery") in ("failed", "refused"):
        attention(ctx, b, "ESCALATION_DELIVERY_FAILED",
                  {"correlation_id": corr, "target": m.get("escalation_target"), "delivery": m["escalation_delivery"]},
                  lambda: "Worker escalation not delivered to its orchestrator_target (%s). The Worker stopped; it never "
                          "falls back to Human/MC. artifact_path=%s error=%s" % (
                              m.get("escalation_target"), m.get("escalation_artifact_path"), m.get("escalation_error")))
    if not corr:
        return
    problem = escalation.check_target(target, mc_identities(ctx), {str(m[k]) for k in ("worker", "pane", "tab") if m.get(k)})
    if problem:
        attention(ctx, b, "ESCALATION_%s" % problem[0], {"correlation_id": corr, "target": target},
                  lambda: "%s\nA Worker with no valid orchestrator_target has no legitimate escalation path; it must "
                          "not ask Human/MC. The reconciler infers and changes nothing." % problem[1])


def check_ack_protocol(ctx, b):
    """Read-only TASK_ACK / TASK_STARTED audit of a Bead dispatched under the protocol (metadata.correlation_id).
    Never writes and never infers an ack: the Worker's helper (task_ack.py) is the only writer of receipt/start
    metadata; here every anomaly is an evidence-only ticket. Returns False when the Bead's protocol state is
    invalid, so no lifecycle action is taken on it this tick. Beads with none of the protocol keys (legacy
    dispatches) are not judged."""
    bead, m = b["id"], meta(b)
    corr = m.get("correlation_id")
    if not any(m.get(k) for k in ("correlation_id", "receipt_id", "start_id")):
        return True
    ack = {k: m.get(k) for k in task_ack.ACK_FIELDS}
    start = {k: m.get(k) for k in task_ack.START_FIELDS}
    facts = None
    if not corr:
        facts = ("ACK_UNCORRELATED", {"receipt_id": m.get("receipt_id"), "start_id": m.get("start_id")})
    elif m.get("start_id") and not m.get("receipt_id"):
        facts = ("START_WITHOUT_ACK", {"correlation_id": corr, "start_id": m["start_id"]})
    elif m.get("receipt_id") and [k for k, v in ack.items() if not v]:
        facts = ("ACK_INCOMPLETE", {"correlation_id": corr, "missing": [k for k, v in ack.items() if not v]})
    elif m.get("start_id") and [k for k, v in start.items() if not v]:
        facts = ("ACK_INCOMPLETE", {"correlation_id": corr, "missing": [k for k, v in start.items() if not v]})
    if facts:
        kind, f = facts
        f = {k: v for k, v in f.items() if v}
        attention(ctx, b, kind, f, lambda: "invalid TASK_ACK/TASK_STARTED metadata on %s: %s\n"
                  "The reconciler infers nothing and changes nothing; the Worker must re-run helper/task_ack.py or "
                  "the Operator must fix the record.\ncorrelation_id=%s ack=%s start=%s" % (
                      bead, json.dumps(f, sort_keys=True), corr, json.dumps(ack, sort_keys=True),
                      json.dumps(start, sort_keys=True)))
        return False
    if not m.get("receipt_id"):
        try:
            age = time.time() - float(m.get("dispatched_at"))
        except (TypeError, ValueError):
            return True  # no dispatch time => cannot judge a deadline; never invent one
        if age >= ctx.ack_after:
            attention(ctx, b, "ACK_MISSING", {"correlation_id": corr, "ack_after": ctx.ack_after},
                      lambda: "no TASK_ACK RECEIVED (receipt_id) recorded within %ss of dispatch; herdr accepting the "
                              "prompt is transport acceptance, not acknowledgement. correlation_id=%s worker=%s pane=%s"
                              % (ctx.ack_after, corr, m.get("worker"), m.get("pane")))
    return True


def id_token(text, ident):
    """ident appears in text delimited by non-alphanumerics (conservative: a parent id also matches its
    children's names, which can only suppress action, never cause it)."""
    return re.search(r"(?<![a-z0-9])%s(?![a-z0-9])" % re.escape(ident.lower()), (text or "").lower()) is not None


def associated_agents(ctx, b):
    """Live agents tied to this Bead without metadata.worker: by name/tab-label token, recorded pane/tab,
    or cwd == the Bead's own worktree. Any status counts as live."""
    bead, m = b["id"], meta(b)
    slug = re.sub(r"[^a-z0-9_-]", "-", bead.lower())
    own = [str(m[k]) for k in ("worktree", "cwd") if m.get(k) and str(m[k]).rstrip("/") != ctx.repo.rstrip("/")]
    found = {}
    for name, a in ctx.agents.items():
        tab_label = (ctx.tabs.get(a.get("tab_id")) or {}).get("label", "")
        why = None
        if id_token(name, slug) or id_token(name, bead):
            why = "name"
        elif id_token(tab_label, bead) or id_token(tab_label, slug):
            why = "tab-label"
        elif m.get("pane") and a.get("pane_id") == m.get("pane"):
            why = "recorded-pane"
        elif m.get("tab") and a.get("tab_id") == m.get("tab"):
            why = "recorded-tab"
        elif any((a.get("cwd") or "").rstrip("/") == o.rstrip("/") for o in own):
            why = "worktree-cwd"
        if why:
            found[name] = (why, a.get("agent_status"))
    return found


def unlinked(ctx, b):
    """in_progress with no metadata.worker. Deterministic rule, no judgement:
      live agent associated  -> working: leave; blocked: ticket; other status: ticket iff stale, else leave
      live lease             -> leave (someone is heartbeating it)
      recent activity        -> leave (< --stale-after since lease expiry/heartbeat/update)
      stale + no live agent  -> re-dispatch iff opt-in label + assignee==actor + budget + redispatch < max;
                                otherwise STALE_UNLINKED ticket (evidence only)."""
    bead, m = b["id"], meta(b)
    now = time.time()
    lease = ts(b.get("lease_expires_at"))
    acts = [t for t in (lease, ts(b.get("heartbeat_at")), ts(b.get("updated_at")), ts(b.get("started_at"))) if t]
    stale = bool(acts) and now - max(acts) > ctx.stale_after  # lease expiry is one of acts, so a live lease is never stale
    assoc = associated_agents(ctx, b)
    if assoc:
        desc = ",".join("%s(%s,%s)" % (n, w, st) for n, (w, st) in sorted(assoc.items()))
        statuses = {st for _, st in assoc.values()}
        if "blocked" in statuses:
            attention(ctx, b, "WORKER_BLOCKED", {"agents": sorted(assoc), "linked_by": "association"},
                      lambda: "unlinked Bead, associated agents: %s" % desc)
        elif "working" in statuses or not stale:
            emit(ctx, "LEAVE", bead, "unlinked but live agent associated: %s" % desc)
        else:
            attention(ctx, b, "UNLINKED_WORKER_IDLE", {"agents": sorted(assoc), "statuses": sorted(map(str, statuses))},
                      lambda: "stale unlinked Bead with non-working agents: %s" % desc)
        return
    if lease is not None and lease > now:
        emit(ctx, "LEAVE", bead, "unlinked, lease live until %s" % b.get("lease_expires_at"))
        return
    if not acts:
        attention(ctx, b, "STALE_UNLINKED", {"why": "no lease/heartbeat/updated_at timestamps"},
                  lambda: "cannot judge staleness: no parseable timestamps")
        return
    if not stale:
        emit(ctx, "LEAVE", bead, "unlinked, last activity <%ss ago (not stale)" % ctx.stale_after)
        return
    n = int(m.get("redispatch", 0) or 0)
    blockers = []
    if b.get("issue_type") not in DISPATCH_TYPES:
        blockers.append("issue_type %s not dispatchable" % b.get("issue_type"))
    if ctx.dispatch_label and ctx.dispatch_label not in labels(b):
        blockers.append("no opt-in label %s" % ctx.dispatch_label)
    if not ctx.callback:
        blockers.append("no --callback target")
    if b.get("assignee") != bd_actor(ctx, None):
        blockers.append("assignee %s is not actor %s" % (b.get("assignee"), bd_actor(ctx, None)))
    if n >= ctx.max_redispatch:
        blockers.append("redispatch budget exhausted (%d)" % n)
    if blockers:
        attention(ctx, b, "STALE_UNLINKED", {"blockers": blockers},
                  lambda: "claimed, no worker link, no live agent, stale > %ss; not auto-recoverable: %s\n"
                          "lease_expires_at=%s heartbeat_at=%s updated_at=%s assignee=%s labels=%s" % (
                              ctx.stale_after, "; ".join(blockers), b.get("lease_expires_at"),
                              b.get("heartbeat_at"), b.get("updated_at"), b.get("assignee"),
                              ",".join(sorted(labels(b)))))
        return
    if not take_budget(ctx, bead):
        return
    emit(ctx, "REDISPATCH", bead, "stale unlinked claim, no live agent -> re-dispatch #%d in a new tab" % (n + 1),
         mutating=True)
    dispatch(ctx, b, redispatch=n + 1, prev_worker=None, unlinked=True)


def take_budget(ctx, bead):
    if ctx.dispatched >= ctx.max_dispatch:
        emit(ctx, "DEFER", bead, "over --max-dispatch=%d this tick" % ctx.max_dispatch)
        return False
    ctx.dispatched += 1
    return True


def ctx_settling(ctx, m):
    try:
        return time.time() - float(m.get("dispatched_at", 0)) < ctx.settle
    except ValueError:
        return False


def handle_status(ctx, b, worker, agent, settling):
    bead, m = b["id"], meta(b)
    status = agent.get("agent_status")
    if m.get("pane") and agent.get("pane_id") != m.get("pane"):
        attention(ctx, b, "WORKER_MISMATCH",
                  {"worker": worker, "recorded_pane": m.get("pane"), "live_pane": agent.get("pane_id")},
                  lambda: "agent %s live pane=%s tab=%s; Bead recorded pane=%s tab=%s" % (
                      worker, agent.get("pane_id"), agent.get("tab_id"), m.get("pane"), m.get("tab")))
        return
    if status == "working":
        emit(ctx, "LEAVE", bead, "worker %s working" % worker)
    elif status == "blocked":
        attention(ctx, b, "WORKER_BLOCKED", {"worker": worker, "status": status},
                  lambda: read_agent(ctx, worker, "visible", 60))
    elif settling:
        emit(ctx, "LEAVE", bead, "worker %s %s but dispatched <%ss ago (settling)" % (worker, status, ctx.settle))
    elif status == "done":
        harvest_close(ctx, b, worker)
    else:
        attention(ctx, b, "WORKER_%s" % str(status).upper(), {"worker": worker, "status": status},
                  lambda: read_agent(ctx, worker, "recent-unwrapped", 60))


def harvest_close(ctx, b, worker):
    """Worker status `done` proves a process stopped, never a verdict. Close only on a valid TASK_RESULT record read
    back from the Bead (helper/task_result.py is its only writer); otherwise evidence only and the Bead stays open.
    No terminal transcript is read or parsed, and nothing is inferred from liveness."""
    bead, m = b["id"], meta(b)
    refuse_mc_bead(ctx, b)
    state, info = task_result.verify_record(m, worker)
    if state != "valid":
        result_gate_ticket(ctx, b, worker, state, info)
        return
    if not recheck_gate(ctx):
        return
    emit(ctx, "HARVEST", bead, "worker %s done, valid TASK_RESULT %s verdict=%s artifact_path=%s -> bd close" % (
        worker, info["result_id"], info["result_verdict"], info["result_artifact_path"]), mutating=True)
    reason = ("reconciler-harvest closed_by=%s worker=%s herdr_status=done result_id=%s verdict=%s "
              "artifact_path=%s correlation_id=%s" % (
                  ACTOR, worker, info["result_id"], info["result_verdict"],
                  info["result_artifact_path"], info["result_correlation_id"]))
    mutate(ctx, BdClose(bead, reason, actor=bd_actor(ctx, b)))


def result_gate_ticket(ctx, b, worker, state, info):
    """done + no/invalid result record: evidence-only WORK_RESULT_MISSING / WORK_RESULT_INVALID, Bead left open."""
    m = meta(b)
    corr = m.get("correlation_id")
    common = ("The reconciler closed nothing, inferred no verdict and read no terminal; the Bead stays open. "
              "correlation_id=%s worker=%s recorded=%s\n" % (
                  corr, worker, json.dumps(task_result.record_of(m), sort_keys=True)))
    if state == "missing":
        attention(ctx, b, "WORK_RESULT_MISSING", {"worker": worker, "correlation_id": corr},
                  lambda: "worker %s reports herdr status done but no TASK_RESULT is recorded on the Bead.\n%sThe Worker "
                          "must run helper/task_result.py before its final callback, or the Operator must decide." % (
                              worker, common))
        return
    attention(ctx, b, "WORK_RESULT_INVALID", {"worker": worker, "correlation_id": corr, "code": info["code"]},
              lambda: "worker %s reports herdr status done but the recorded TASK_RESULT is invalid: %s: %s\n%s"
                      "Only helper/task_result.py may write the record; do not hand-edit it." % (
                          worker, info["code"], info["detail"], common))


def ghost(ctx, b, worker):
    bead, m = b["id"], meta(b)
    refuse_mc_bead(ctx, b)
    n = int(m.get("redispatch", 0) or 0)
    if n >= ctx.max_redispatch:
        attention(ctx, b, "REDISPATCH_EXHAUSTED", {"worker": worker, "redispatch": n},
                  lambda: "worker %s NOT_FOUND after %d re-dispatches" % (worker, n))
        return
    if not take_budget(ctx, bead):
        return
    emit(ctx, "REDISPATCH", bead, "worker %s NOT_FOUND -> re-dispatch #%d" % (worker, n + 1), mutating=True)
    dispatch(ctx, b, redispatch=n + 1, prev_worker=worker)


# --------------------------------------------------------------------------
# Action 3: reaper
# --------------------------------------------------------------------------
def reap(ctx):
    for b in ctx.closed:
        bead, m = b["id"], meta(b)
        for tab in tab_ids(b):
            if tab not in ctx.tabs:
                continue
            if tab in ctx.protected["tabs"]:
                emit(ctx, "SKIP", bead, "tab %s is mc/MC-owned or in the MC workspace: never touched" % tab)
                attention(ctx, b, "MC_PROTECTED", {"tab": tab, "detail": "closed Bead metadata points at a protected tab"},
                          lambda: "Bead %s metadata.tab=%s is mc/MC-owned; reaper refused (Operator must fix the link)" % (bead, tab))
                continue
            owned = mc_owned(ctx, b)
            if owned:
                emit(ctx, "SKIP", bead, "MC ownership Bead (%s): its tab %s is never reaped" % (owned, tab))
                continue
            why = reap_blocker(ctx, b, tab)
            if why:
                emit(ctx, "SKIP", bead, "tab %s live but not reaped: %s" % (tab, why))
                continue
            if not recheck_gate(ctx):
                return
            emit(ctx, "REAP", bead, "closed Bead, tab %s live -> herdr tab close" % tab, mutating=True)
            try:
                mutate(ctx, TabClose(bead, tab))
            except StepError as e:
                ctx.errors += 1
                emit(ctx, "ERROR", bead, str(e))
                if isinstance(e, GuardViolation):
                    attention(ctx, b, "MC_PROTECTED", {"tab": tab, "detail": str(e)}, lambda: str(e))


def reap_blocker(ctx, b, tab):
    m = meta(b)
    if tab == ctx.self_tab:
        return "it is the reconciler's own tab"
    try:
        age = time.time() - iso_epoch(b.get("closed_at"))
    except (ValueError, TypeError):
        return "closed_at unparseable (fail closed)"
    if age < ctx.reap_grace:
        return "closed <%ss ago (grace for final callback)" % ctx.reap_grace
    others = ctx.busy_tabs.get(tab, set()) - {b["id"]}
    if others:
        return "tab also recorded by open Bead(s) %s" % ",".join(sorted(others))
    if ctx.tabs[tab].get("pane_count", 1) != 1:
        return "tab has %s panes (not a single-agent tab)" % ctx.tabs[tab].get("pane_count")
    for a in ctx.agents.values():
        if a.get("tab_id") == tab:
            if a.get("agent_status") == "working":
                return "agent %s still working (final callback pending)" % a.get("name")
            if a.get("name") != m.get("worker") and a.get("name") not in str(m.get("prev_workers", "")).split(","):
                return "tab hosts agent %s which is not this Bead's worker" % a.get("name")
    return None


def iso_epoch(s):
    import calendar
    return calendar.timegm(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S"))


# --------------------------------------------------------------------------
# Action 4: blocked / needs-decision
# --------------------------------------------------------------------------
def attention_beads(ctx):
    seen = set()
    for b in ctx.attn:
        if b["id"] in seen:
            continue
        seen.add(b["id"])
        kind = "BEAD_BLOCKED" if b.get("status") == "blocked" else "NEEDS_DECISION"
        attention(ctx, b, kind, {"status": b.get("status"), "labels": sorted(labels(b))},
                  lambda b=b: "status=%s assignee=%s labels=%s\nnotes:\n%s" % (
                      b.get("status"), b.get("assignee"), ",".join(sorted(labels(b))), (b.get("notes") or "")[-2000:]))


# --------------------------------------------------------------------------
# Action 1: dispatch (also used by re-dispatch)
# --------------------------------------------------------------------------
def resolve_workspace(ctx):
    rc, data = herdr_result(ctx, "workspace", "list")
    if rc != 0:
        raise StepError("workspace list failed")
    label = os.path.basename(ctx.repo.rstrip("/"))
    found = [w for w in data.get("result", {}).get("workspaces", []) if w.get("label") == label]
    if len(found) != 1:
        raise StepError("workspace label %r matches %d spaces (need exactly 1)" % (label, len(found)))
    return found[0]["workspace_id"]


def worker_name(ctx, bead, n):
    base = "r-" + re.sub(r"[^a-z0-9_-]", "-", bead.lower())
    name = (base[:28] + ("-%d" % n if n else ""))[:32]
    if name in ctx.agents or name in ctx.new_names:
        raise StepError("worker name %s already live (fail closed)" % name)
    ctx.new_names.add(name)
    return name


def correlation_id(bead, dispatched_at, redispatch):
    """One id per dispatch, stamped on the Bead before the prompt; every ack/start must echo it back."""
    return "corr.%s.%d.%d" % (bead, dispatched_at, redispatch)


def ack_instructions(ctx, bead, name, correlation):
    """FIRST-ACTION contract text: fixed grammar, literal ids (deterministic per dispatch, so a retry is a duplicate)."""
    base = "python3 %s --repo %s" % (shell_quote(TASK_ACK_HELPER), shell_quote(ctx.repo))
    return ("ACK FIRST (before any work). Herdr accepting this prompt is NOT an acknowledgement; only the Bead write "
            "is. correlation_id=%s. (1) `%s ack --bead-id %s --correlation-id %s --receipt-id rcpt.%s "
            "--acknowledged-by %s`. (2) then, once you begin, `%s start --bead-id %s --correlation-id %s --start-id "
            "start.%s --worker %s --pane \"$HERDR_PANE_ID\" --tab \"$HERDR_TAB_ID\"`. Each prints one JSON object: "
            "on exit 0 push its `envelope` field verbatim to your orchestrator_target %s with herdr agent prompt "
            "(no --wait); repeating a command is safe (status DUPLICATE). On exit 3 push its `envelope` (ATTENTION "
            "REQUIRED ...) to %s only and STOP: do no work, do not close the Bead, do not guess or hand-write "
            "receipt/start metadata."
            % (correlation, base, bead, correlation, correlation, name, base, bead, correlation, correlation, name,
               ctx.callback, ctx.callback))


def escalation_instructions(ctx, bead, correlation):
    """The Worker's only channel for blockers/questions: the stamped orchestrator_target, via helper/escalation.py."""
    base = "python3 %s --repo %s" % (shell_quote(ESCALATION_HELPER), shell_quote(ctx.repo))
    return ("ESCALATION (the only path). Your orchestrator_target is %s (stamped on the Bead). Every blocker, question, "
            "approval request or decision need goes ONLY to it, as a correlated ATTENTION REQUIRED: write the report, "
            "then `%s --bead-id %s --correlation-id %s --type <BLOCKER|QUESTION> --artifact-path <report>`. NEVER ask "
            "the Human Operator or Mission Control (mc) directly: no interactive/ask-user question, no prompt to an mc "
            "or human-facing pane, no other target, no fallback. If it exits non-zero the delivery failed or was "
            "refused; the evidence is already on the Bead (and a DELIVERY_FAILED notice went to the same target if "
            "possible): STOP - no work, no Bead close, no retry elsewhere."
            % (ctx.callback, base, bead, correlation))


def result_instructions(ctx, bead, name, correlation, report):
    """The Worker records its result on the Bead BEFORE closing or calling back; the record is what harvest trusts."""
    base = "python3 %s --repo %s" % (shell_quote(TASK_RESULT_HELPER), shell_quote(ctx.repo))
    return ("RESULT (record it before any close or callback). Once the report exists: `%s --bead-id %s --correlation-id "
            "%s --result-id res.%s --result-by %s --verdict <pass|fail> --artifact-path %s`. It prints one JSON object; "
            "repeating it is safe (status DUPLICATE). On exit 0 its `callback_envelope` field is your final callback, "
            "pushed verbatim. On exit 3 push its `envelope` (ATTENTION REQUIRED ...) to %s only and STOP: no Bead close, "
            "no WORK_RESULT callback, do not hand-write result metadata. A finished terminal is not a result; only this "
            "record is." % (base, bead, correlation, correlation, name, report, ctx.callback))


def task_text(ctx, b, name, correlation, prev_worker=None, unlinked=False):
    bead = b["id"]
    report = "/tmp/%s-report.md" % bead
    parts = ["You are the Worker for bead_id=%s (dispatched by a4s-reconcile). Work only in your cwd. "
             "No in-session subagents, no polling." % bead,
             ack_instructions(ctx, bead, name, correlation),
             escalation_instructions(ctx, bead, correlation),
             result_instructions(ctx, bead, name, correlation, report),
             "TITLE: %s" % b.get("title", "")]
    for key in ("description", "design", "acceptance_criteria", "notes"):
        if b.get(key):
            parts.append("%s:\n%s" % (key.upper(), b[key]))
    if prev_worker:
        parts.append("NOTE: previous worker %s vanished before closing this Bead; inspect repo state and any "
                     "existing report before repeating work." % prev_worker)
    elif unlinked:
        parts.append("NOTE: this Bead was claimed but its claimant left no worker link and no live agent; inspect "
                     "repo state, any worktree and any existing report before repeating work.")
    parts.append("DELIVER: bounded report at %s (verdict, evidence, bead_id). Then record it (see RESULT). Only after "
                 "that exits 0: BEADS_ACTOR=\"%s\" bd close %s --reason \"worker=%s verdict=<pass|fail> artifact_path=%s\" "
                 "(bd's assignee guard refuses any other actor; never use --force) and, as your final action, herdr agent "
                 "prompt %s with the `callback_envelope` RESULT printed. If blocked or in doubt: do NOT close the Bead "
                 "and escalate ONLY as described under ESCALATION (never to Human/MC). Never create, move, relabel or "
                 "prompt-drive an mc pane." % (report, bd_actor(ctx, b), bead, name, report, ctx.callback))
    return "\n\n".join(parts)


def extract(v, key):
    return v.get(key) if isinstance(v, dict) else v


def dispatch(ctx, b, redispatch=0, prev_worker=None, unlinked=False):
    bead, m = b["id"], meta(b)
    refuse_mc_bead(ctx, b)  # before the first tab/agent mutation, which precedes any bd write
    if not recheck_gate(ctx):
        return
    kind = str(m.get("kind") or ctx.default_kind)
    if kind not in ALLOWED_KINDS:
        raise StepError("metadata.kind=%r not in %s (fail closed)" % (kind, sorted(ALLOWED_KINDS)))
    model = m.get("model") or (ctx.default_model if kind == "claude" else None)
    cwd = str(m.get("cwd") or m.get("worktree") or ctx.repo)
    if not os.path.isabs(cwd) or not os.path.isdir(cwd):
        raise StepError("cwd %r is not an existing absolute dir (fail closed)" % cwd)
    if not ctx.callback:
        raise StepError("no --callback target configured (fail closed)")
    ws = resolve_workspace(ctx)
    try:
        guard_workspace(ctx, ws)
    except GuardViolation as e:
        ctx.errors += 1
        emit(ctx, "ERROR", bead, "dispatch refused: %s" % e)
        attention(ctx, b, "MC_PROTECTED", {"workspace": ws, "detail": str(e)}, lambda: str(e))
        return
    name = worker_name(ctx, bead, redispatch)
    problem = orchestrator_target_problem(ctx, ctx.callback, worker=name)
    if problem:  # before the claim: no PO target => no dispatch, and never a fallback to Human/MC
        attention(ctx, b, "ORCHESTRATOR_%s" % problem[0], {"target": ctx.callback}, lambda: problem[1])
        raise StepError("%s: %s (fail closed; Human/MC is never a target)" % problem)
    dispatched_at = int(time.time())
    correlation = correlation_id(bead, dispatched_at, redispatch)
    step = "claim"
    try:
        if not redispatch:
            mutate(ctx, BdUpdate(bead, ("--claim",), dispatch_id=correlation))
        step = "tab create"
        tab_change = TabCreate(bead, correlation, ws, cwd, bead)
        if ctx.apply:
            _, out, _ = mutate(ctx, tab_change)
            res = (parse_json(out) or {}).get("result", {})
            tab = extract(res.get("tab"), "tab_id")
            pane = extract(res.get("root_pane"), "pane_id")
            if not tab or not pane:
                raise StepError("tab create returned no tab/root_pane: %s" % out[:200])
        else:
            mutate(ctx, tab_change)
            tab, pane = "tab-id", "pane-id"
        step = "worker-link"
        stamp = ["--set-metadata", "worker=%s" % name, "--set-metadata", "pane=%s" % pane,
                 "--set-metadata", "tab=%s" % tab, "--set-metadata", "dispatched_at=%d" % dispatched_at,
                 "--set-metadata", "redispatch=%d" % redispatch, "--set-metadata", "correlation_id=%s" % correlation,
                 "--set-metadata", "orchestrator_target=%s" % ctx.callback]
        if redispatch:
            # a new dispatch is a new correlation: acks/starts/results of the previous worker prove nothing about this one
            for key in task_ack.RESET_FIELDS + task_result.RESULT_FIELDS:
                if m.get(key):
                    stamp += ["--unset-metadata", key]
            olds = [x for x in [str(m.get("tab", "")), str(m.get("prev_tabs", ""))] if x]
            stamp += ["--set-metadata", "prev_tabs=%s" % ",".join(olds),
                      "--set-metadata", "prev_workers=%s" % ",".join(
                          x for x in [str(m.get("worker", "")), str(m.get("prev_workers", ""))] if x)]
        mutate(ctx, BdUpdate(bead, tuple(stamp), actor=bd_actor(ctx, b), dispatch_id=correlation))
        step = "agent start"
        mutate(ctx, AgentStart(bead, correlation, name, pane, kind, str(model) if model else None))
        step = "prompt"
        mutate(ctx, AgentPrompt(bead, correlation, name, task_text(ctx, b, name, correlation, prev_worker, unlinked)))
    except StepError as e:
        ctx.errors += 1
        emit(ctx, "ERROR", bead, "dispatch failed at %s: %s" % (step, e))
        attention(ctx, b, "MC_PROTECTED" if isinstance(e, GuardViolation) else "DISPATCH_FAILED",
                  {"step": step, "worker": name},
                  lambda: "dispatch failed at step %s: %s\nBead may be claimed/stamped without a live worker; "
                          "the next tick re-dispatches (bounded) via NOT_FOUND." % (step, e))


def dispatch_ready(ctx):
    if not ctx.ready:
        return
    if not ctx.callback:
        emit(ctx, "SKIP", None, "%d ready Bead(s) but no --callback target; dispatch disabled (fail closed)" % len(ctx.ready))
        return
    actor = bd_actor(ctx, None)
    for b in ctx.ready:
        bead, m = b["id"], meta(b)
        if b.get("issue_type") not in DISPATCH_TYPES:
            continue
        why = mc_owned(ctx, b)
        if why:
            emit(ctx, "SKIP", bead, "ready but MC ownership Bead (%s): never dispatched or claimed" % why)
            continue
        if ctx.dispatch_label and ctx.dispatch_label not in labels(b):
            continue
        if m.get("worker"):
            emit(ctx, "SKIP", bead, "ready but carries worker link %s (ambiguous; fail closed)" % m.get("worker"))
            continue
        if b.get("assignee") and b["assignee"] != actor:
            emit(ctx, "SKIP", bead, "ready but assigned to %s (not %s)" % (b["assignee"], actor))
            continue
        if not take_budget(ctx, bead):
            continue
        emit(ctx, "DISPATCH", bead, "ready -> claim, tab, link worker, start agent, prompt bead content", mutating=True)
        try:
            dispatch(ctx, b)
        except StepError as e:
            ctx.errors += 1
            emit(ctx, "ERROR", bead, str(e))


# --------------------------------------------------------------------------
def default_repo():
    rc, out, _ = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"])
    if rc == 0 and out.strip():
        return os.path.dirname(out.strip().rstrip("/"))
    return os.getcwd()


def open_lock(path, exclusive, create, nonblocking=False):
    root = os.path.dirname(os.path.dirname(os.path.dirname(path)))
    secure_tree(root, ("state", "reconcile"), create)
    info = _lstat(path)
    created = False
    if info is None:
        if not create:
            return None
        secure_dir(os.path.dirname(path), True)
        created = True
    flags = (os.O_RDWR if create else os.O_RDONLY) | getattr(os, "O_NOFOLLOW", 0)
    if create:
        flags |= os.O_CREAT
    before = _lstat(path)
    if before is not None and (stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode)):
        raise OSError("lock is not a regular file")
    fd = os.open(path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode)
            or (before is not None and (before.st_dev, before.st_ino) != (info.st_dev, info.st_ino))):
        os.close(fd)
        raise OSError("lock is not a regular file")
    if stat.S_IMODE(info.st_mode) != 0o600:
        if not create:
            os.close(fd)
            raise OSError("lock mode is not 0600")
        os.fchmod(fd, 0o600)
    if created:
        dfd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    mode = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
    if nonblocking:
        mode |= fcntl.LOCK_NB
    try:
        fcntl.flock(fd, mode)
    except BaseException:
        os.close(fd)
        raise
    return fd


def audit_status(ctx):
    lock = None
    try:
        lock = open_lock(ctx.lock_path, exclusive=False, create=True)
        if secure_tree(ctx.root, ("audit", "reconcile"), False):
            view = read_audit(ctx.audit_path)
        else:
            view = {"records": [], "mutations": {}, "global_block": False}
    except (AuditCorrupt, OSError):
        print(json.dumps({"schema": AUDIT_VERSION, "status": "corrupt", "code": "audit-corrupt"}, sort_keys=True))
        return 3
    finally:
        if lock is not None:
            os.close(lock)
    open_items = []
    for mutation_id, mutation in sorted(view["mutations"].items()):
        state = mutation_state(mutation)
        if state in ("pending", "ambiguous"):
            intent = mutation["intent"]
            open_items.append({"mutation_id": mutation_id, "operation": intent["operation"],
                               "scopes": intent.get("scopes"), "status": state})
    print(json.dumps({"schema": AUDIT_VERSION, "status": "ok", "global_block": view["global_block"],
                      "open": open_items, "records": len(view["records"])}, sort_keys=True))
    return 0


def audit_resolve(ctx, mutation_id, decision):
    lock = None
    try:
        lock = open_lock(ctx.lock_path, exclusive=True, create=True)
        try:
            if secure_tree(ctx.root, ("audit", "reconcile"), False):
                view = read_audit(ctx.audit_path)
            else:
                view = {"records": [], "mutations": {}, "global_block": False}
        except (AuditCorrupt, OSError):
            print("audit is corrupt; resolution refused")
            return 3
        mutation = view["mutations"].get(mutation_id)
        if mutation is None:
            print("unknown mutation id; resolution refused")
            return 2
        if mutation["resolution"] is not None or mutation_state(mutation) not in ("pending", "ambiguous"):
            print("mutation is closed; resolution refused")
            return 2
        intent = mutation["intent"]
        status = "applied" if decision == "mutation-applied" else "not-applied"
        record = audit_record(mutation_id, "resolution", intent["operation"], intent["ids"],
                              intent.get("scopes"), status, "human-resolution")
        append_durable(ctx.audit_path, record)
        print(json.dumps({"schema": AUDIT_VERSION, "mutation_id": mutation_id,
                          "status": status, "event": "resolution"}, sort_keys=True))
        return 0
    except (OSError, AuditCorrupt):
        print("resolution persistence failed")
        return 3
    finally:
        if lock is not None:
            os.close(lock)


def run_tick(ctx, args):
    print("a4s-reconcile mode=%s repo=%s" % ("APPLY" if ctx.apply else "DRY-RUN", ctx.repo))
    lock = None
    if ctx.apply:
        try:
            lock = open_lock(ctx.lock_path, exclusive=True, create=True, nonblocking=True)
        except BlockingIOError:
            ctx.log("lock.result", "contended")
            print("another tick holds the lock -> no-op")
            return 0
        except OSError:
            print("canonical lock is unsafe -> no-op")
            return 3
        ctx.log("lock.result", "acquired")
        ctx.log("tick.start", "started")
    try:
        try:
            if secure_tree(ctx.root, ("audit", "reconcile"), False):
                ctx.audit_view = read_audit(ctx.audit_path)
            else:
                ctx.audit_view = {"records": [], "mutations": {}, "global_block": False}
        except (AuditCorrupt, OSError):
            ctx.log("tick.result", "blocked", code="audit-corrupt")
            print("audit is corrupt; all mutations are blocked")
            return 3
        if not herdr_running(ctx):
            print("herdr server not running -> no-op")
            ctx.log("tick.result", "noop", code="herdr-down")
            return 0
        try:
            snapshot(ctx)
        except (Abort, KeyError) as exc:
            print("snapshot failed, aborting without mutation: %s" % exc)
            ctx.log("snapshot.result", "failed")
            ctx.log("tick.result", "failed", code="snapshot-failed")
            return 3
        ctx.log("snapshot.result", "ok", in_progress=len(ctx.in_progress), ready=len(ctx.ready),
                attention=len({b['id'] for b in ctx.attn}), closed=len(ctx.closed))
        print("snapshot: in_progress=%d ready=%d attention-candidates=%d closed-with-tab=%d agents=%d tabs=%d" % (
            len(ctx.in_progress), len(ctx.ready), len({b['id'] for b in ctx.attn}), len(ctx.closed),
            len(ctx.agents), len(ctx.tabs)))
        if ctx.gate["verdict"] == "OK":
            emit(ctx, "MC-GATE", None, "OPEN owner=%s pane=%s" % (ctx.gate["owner"]["bead"], ctx.gate["owner"]["pane"]))
            ctx.log("gate.result", "open")
        else:
            emit(ctx, "MC-GATE", None, "CLOSED (%s): %s" % (ctx.gate["verdict"], " | ".join(ctx.gate["reasons"])))
            ctx.log("gate.result", "closed", verdict=ctx.gate["verdict"])
            gate_ticket(ctx)
        try:
            if ctx.gate["verdict"] == "OK" or ctx.plan_ungated:
                if ctx.gate["verdict"] != "OK":
                    print("      !! --plan-ignoring-mc-gate: plan below is what WOULD run if the gate were open (read-only)")
                reconcile_in_progress(ctx)
                reap(ctx)
                attention_beads(ctx)
                dispatch_ready(ctx)
            else:
                print("      all bd/herdr mutations disabled this tick; only evidence-only tickets are written")
                attention_beads(ctx)
        except MutationHalt as exc:
            ctx.errors += 1
            print("mutation halt: %s" % exc)
            ctx.log("tick.result", "halted", code="mutation-halt")
            return 4
        planned = sum(1 for a in ctx.actions if a["mutating"] and a["kind"] != "ATTENTION")
        tickets = sum(1 for a in ctx.actions if a["kind"] == "ATTENTION" and a["mutating"])
        print("summary: %s=%d tickets=%d errors=%d" % ("applied" if ctx.apply else "planned", planned, tickets, ctx.errors))
        if args.json:
            print(json.dumps({"gate": {k: ctx.gate[k] for k in ("verdict", "reasons", "owner")},
                              "actions": ctx.actions}, indent=1))
        result = 1 if ctx.errors else 0
        ctx.log("tick.result", "failed" if result else "ok", errors=ctx.errors)
        return result
    except (OSError, StepError):
        ctx.log("tick.result", "failed", code="internal-persistence")
        print("internal persistence failed; tick stopped")
        return 3
    finally:
        if lock is not None:
            os.close(lock)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Deterministic Bead/Herdr reconciler (dry-run by default).")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="print planned actions and write nothing (default)")
    mode.add_argument("--apply", action="store_true", help="execute one mutating tick")
    mode.add_argument("--audit-status", action="store_true", help="read audit state under a shared lock")
    mode.add_argument("--audit-resolve", metavar="ID", help="append one human resolution")
    ap.add_argument("--decision", choices=("mutation-applied", "mutation-not-applied"))
    ap.add_argument("--confirm-human", action="store_true")
    ap.add_argument("--repo", default=None, help="repo root owning .beads (default: git common dir parent)")
    ap.add_argument("--root", "--a4s-root", dest="root", default=None,
                    help="A4S persistence root (default: A4S_STATE_ROOT or XDG state/a4s)")
    ap.add_argument("--state-dir", default=None,
                    help="deprecated root alias; a path ending in reconcile maps to its parent")
    ap.add_argument("--callback", "--orchestrator-target", dest="callback",
                    default=os.environ.get("A4S_RECONCILE_CALLBACK", ""),
                    help="Project Orchestrator pane/name used for Worker callbacks")
    ap.add_argument("--dispatch-label", default="auto-dispatch")
    ap.add_argument("--settle", type=int, default=60)
    ap.add_argument("--reap-grace", type=int, default=120)
    ap.add_argument("--max-redispatch", type=int, default=2)
    ap.add_argument("--stale-after", type=int, default=1800)
    ap.add_argument("--ack-after", type=int, default=300)
    ap.add_argument("--mc-grace", type=int, default=60)
    ap.add_argument("--plan-ignoring-mc-gate", action="store_true")
    ap.add_argument("--max-dispatch", type=int, default=3)
    ap.add_argument("--default-kind", default="claude", choices=sorted(ALLOWED_KINDS))
    ap.add_argument("--default-model", default="sonnet")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    if args.root and args.state_dir:
        ap.error("--root and --state-dir are exclusive")
    if args.state_dir:
        legacy = os.path.abspath(args.state_dir)
        args.root = os.path.dirname(legacy) if os.path.basename(legacy) == "reconcile" else legacy
    else:
        selected = os.path.abspath(args.root or os.environ.get("A4S_RECONCILE_STATE") or A4S_ROOT_DEFAULT)
        args.root = os.path.dirname(selected) if (not args.root and os.environ.get("A4S_RECONCILE_STATE")
                                                   and os.path.basename(selected) == "reconcile") else selected
    if args.plan_ignoring_mc_gate and (args.apply or args.audit_status or args.audit_resolve):
        ap.error("--plan-ignoring-mc-gate is dry-run only")
    if args.audit_resolve:
        if not args.decision or not args.confirm_human:
            ap.error("--audit-resolve requires --decision and --confirm-human")
    elif args.decision or args.confirm_human:
        ap.error("--decision and --confirm-human require --audit-resolve")
    args.repo = os.path.abspath(args.repo or default_repo())
    ctx = Ctx(args)
    if args.audit_status:
        return audit_status(ctx)
    if args.audit_resolve:
        return audit_resolve(ctx, args.audit_resolve, args.decision)
    return run_tick(ctx, args)


if __name__ == "__main__":
    sys.exit(main())
