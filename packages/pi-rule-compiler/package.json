{
  "name": "@a4s/pi-rule-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:evidence": "tsx eval/evidence/run.ts",
    "e2e": "tsx scripts/run-headless-e2e.ts",
    "rpc:compact-driver": "tsx scripts/run-rpc-compact.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "dependencies": {
    "@a4s/typesafe": "0.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
