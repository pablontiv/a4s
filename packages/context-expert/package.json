  "private": true,
  "license": "MIT",
  "description": "Host-neutral Jev compaction core with Claude (mod) and Pi (extension) adapters. PoC port of context-expert to Claude Code, reusing fast-jev-compaction (MIT).",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
