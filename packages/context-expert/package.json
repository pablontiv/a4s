{
  "name": "@a4s/context-expert",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Host-neutral Jev compaction core with live adapters for Pi/Pion and Claude Code.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablontiv/a4s.git",
    "directory": "packages/context-expert"
  },
  "homepage": "https://github.com/pablontiv/a4s/tree/main/packages/context-expert#readme",
  "bugs": {
    "url": "https://github.com/pablontiv/a4s/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./core/index.ts",
    "./claude": "./adapters/claude/hooks/register.ts",
    "./pi": "./adapters/pi/src/index.ts"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/src/reloadable.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts adapters/pi/test/*.test.ts",
    "test:e2e:offline": "tsx --test adapters/pi/test/consumer-lifecycle.e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.hooks.json && tsc --noEmit -p adapters/pi/tsconfig.json",
    "sync-core": "node adapters/claude/scripts/sync-core.mjs",
    "check-core": "node adapters/claude/scripts/sync-core.mjs --check",
    "eval:evidence": "tsx adapters/pi/eval/evidence/run.ts",
    "e2e": "tsx adapters/pi/scripts/run-headless-e2e.ts",
    "rpc:compact-driver": "tsx adapters/pi/scripts/run-rpc-compact.ts"
  },
  "dependencies": {
    "@a4s/omp-hot-reload": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@pablontiv/pion": ">=1.0.4 || 1.0.2-dev.40713b10ba6db5c6f083026e3367e2af72cea0ea"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@pablontiv/pion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@pablontiv/pion": "https://github.com/pablontiv/pi/releases/download/pion-local-v1.0.2-dev.40713b10ba6db5c6f083026e3367e2af72cea0ea/pablontiv-pion-1.0.2-dev.40713b10ba6db5c6f083026e3367e2af72cea0ea.tgz",
    "@types/node": "26.6.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
