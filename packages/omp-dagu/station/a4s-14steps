#!/usr/bin/env bash
# Shell/omp for the 14-step a4s lifecycle on the isolated dagu 2.26.0 station.
# Usage: a4s-14steps                         -> omp with the plugin in PRIMARY, no role
#        a4s-14steps <supervisor|coordinator|researcher> [omp args...] -> role session in PRIMARY
#        a4s-14steps -<omp flag> [args...]    -> omp with the plugin in PRIMARY, no role
#        a4s-14steps <cmd...>                -> run <cmd> in the caller's cwd with the station environment
set -euo pipefail
export DAGU_HOME=/home/pones/.dagu-14steps DAGU_URL=http://127.0.0.1:8090 DAGU_PORT=8090
export PATH=/home/pones/.local/opt/dagu-2.26.0:$PATH
if (($#)); then
  case "$1" in
    supervisor|coordinator|researcher)
      role=$1
      shift
      set -- --a4s-role "$role" "$@"
      ;;
    -*) ;;
    *) exec "$@" ;;
  esac
fi
cd /home/shared/harness/a4s
exec omp -e /home/shared/harness/a4s/packages/omp-dagu "$@"
