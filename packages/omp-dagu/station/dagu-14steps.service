[Unit]
Description=Dagu 2.19.2 station for the a4s 14-step lifecycle (dagu-14steps)
After=network-online.target

[Service]
Environment="DAGU_HOME=/home/pones/.dagu-14steps"
Environment="DAGU_URL=http://127.0.0.1:8090"
# triage_decision reads the run back through REST on ${DAGU_PORT:-8080}.
Environment="DAGU_PORT=8090"
Environment="PATH=/home/pones/.local/opt/dagu-2.19.2:/run/current-system/sw/bin:/etc/profiles/per-user/pones/bin:/home/pones/.local/bin"
ExecStart=/home/pones/.local/opt/dagu-2.19.2/dagu start-all
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
