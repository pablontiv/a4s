{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "protocol.ts",
    "observer.ts",
    "observer-cli.ts",
    "adapters/omp/**/*.ts",
    "adapters/session/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
