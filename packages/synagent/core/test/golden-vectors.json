{
  "//": "Vectores dorados host-neutral (ADR 0069). `wire` es el serialize() canónico EXACTO (orden de claves de createCanonical: id,from,to,kind,body,[reply_to],[correlation_id],[causation_id],ts) — debe re-serializar idéntico. `topic` es toTopic(to) o null para direcciones legacy planas. acceptPlain es acceptInbound() con global=false; acceptGlobal usa el default global habilitado. Cualquier adaptador, actual o futuro, debe reproducir esto.",
  "identity": { "project": "a4s", "instance": "sess-01" },
  "legacyAddress": "claude",
  "vectors": [
    {
      "name": "directo a mí (task.request)",
      "wire": "{\"id\":\"g1\",\"from\":\"a4s/pi-1\",\"to\":\"a4s/sess-01\",\"kind\":\"task.request\",\"body\":\"hola\",\"ts\":1}",
      "topic": "synagent/v1/a4s/sess-01",
      "acceptPlain": true,
      "acceptGlobal": true
    },
    {
      "name": "broadcast de proyecto (note.published)",
      "wire": "{\"id\":\"g2\",\"from\":\"a4s/pi-1\",\"to\":\"a4s/all\",\"kind\":\"note.published\",\"body\":\"aviso\",\"ts\":2}",
      "topic": "synagent/v1/a4s/all",
      "acceptPlain": true,
      "acceptGlobal": true
    },
    {
      "name": "global (note.published) — default-on con opt-out",
      "wire": "{\"id\":\"g3\",\"from\":\"otro/x\",\"to\":\"all\",\"kind\":\"note.published\",\"body\":\"global\",\"ts\":3}",
      "topic": "synagent/v1/all",
      "acceptPlain": false,
      "acceptGlobal": true
    },
    {
      "name": "task.redirect directo (OK)",
      "wire": "{\"id\":\"g4\",\"from\":\"a4s/pi-1\",\"to\":\"a4s/sess-01\",\"kind\":\"task.redirect\",\"body\":\"corrige\",\"ts\":4}",
      "topic": "synagent/v1/a4s/sess-01",
      "acceptPlain": true,
      "acceptGlobal": true
    },
    {
      "name": "task.redirect a broadcast (rechazado en recepción)",
      "wire": "{\"id\":\"g5\",\"from\":\"a4s/pi-1\",\"to\":\"a4s/all\",\"kind\":\"task.redirect\",\"body\":\"no\",\"ts\":5}",
      "topic": "synagent/v1/a4s/all",
      "acceptPlain": false,
      "acceptGlobal": false
    },
    {
      "name": "task.completed correlacionado a otra instancia (no para mí)",
      "wire": "{\"id\":\"g6\",\"from\":\"a4s/pi-1\",\"to\":\"a4s/otra\",\"kind\":\"task.completed\",\"body\":\"ok\",\"reply_to\":\"g1\",\"correlation_id\":\"g1\",\"causation_id\":\"g1\",\"ts\":6}",
      "topic": "synagent/v1/a4s/otra",
      "acceptPlain": false,
      "acceptGlobal": false
    },
    {
      "name": "legacy plano (dual-read)",
      "wire": "{\"id\":\"g7\",\"from\":\"pi\",\"to\":\"claude\",\"kind\":\"task.request\",\"body\":\"legacy\",\"ts\":7}",
      "topic": null,
      "acceptPlain": true,
      "acceptGlobal": true
    },
    {
      "name": "self-echo (from = mi propia dirección) — no entregar",
      "wire": "{\"id\":\"g8\",\"from\":\"a4s/sess-01\",\"to\":\"a4s/all\",\"kind\":\"note.published\",\"body\":\"mío\",\"ts\":8}",
      "topic": "synagent/v1/a4s/all",
      "acceptPlain": false,
      "acceptGlobal": false
    },
    {
      "name": "directo desde instancia con ID largo (>64 chars, non-lossy)",
      "wire": "{\"id\":\"g9\",\"from\":\"a4s/sess-01hxyz-0b0ae61c6f0c-abcdefghijklmnopqrstuvwxyz-01\",\"to\":\"a4s/sess-01\",\"kind\":\"task.request\",\"body\":\"long-id\",\"ts\":9}",
      "topic": "synagent/v1/a4s/sess-01",
      "acceptPlain": true,
      "acceptGlobal": true
    }
  ]
}
