{
  "name": "@a4s/issue-lifecycle",
  "version": "0.7.9",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablontiv/a4s.git",
    "directory": "packages/issue-lifecycle"
  },
  "homepage": "https://github.com/pablontiv/a4s/tree/main/packages/issue-lifecycle#readme",
  "bugs": {
    "url": "https://github.com/pablontiv/a4s/issues"
  },
  "type": "module",
  "daguFeature": {
    "integrationBase": "main"
  },
  "exports": {
    "./status": "./src/status/index.ts",
    "./triage": "./src/triage/native.ts"
  },
  "omp": {
    "extensions": [
      "./src/status/reloadable.ts",
      "./src/triage/reloadable.ts"
    ]
  },
  "scripts": {
    "test": "tsx --import ./test/fixtures/dagu-home.mjs --import ../../scripts/test-no-spawn.mjs --test test/*.test.ts",
    "test:live": "python3 bin/heavy-slot.py env A4S_LIVE_DAGU=1 tsx --import ./test/fixtures/dagu-home.mjs --test test/live/*.test.ts",
    "test:compiled": "python3 bin/heavy-slot.py env A4S_COMPILED_SMOKE=1 tsx --import ./test/fixtures/dagu-home.mjs --test --test-concurrency=1 test/live/executable.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a4s/hot-reload": "*",
    "@a4s/launcher": "*",
    "yaml": "2.9.0"
  }
}
