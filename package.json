{
  "name": "a4s",
  "version": "0.0.0-e0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck:e0 && npm run typecheck --workspace @a4s/pi-rule-compiler",
    "typecheck:e0": "tsc --noEmit",
    "test": "npm run test:e0 && npm test --workspace @a4s/pi-rule-compiler",
    "test:e0": "tsx --test test/*.test.ts",
    "e0": "tsx src/e0/driver.ts",
    "e0:report": "tsx src/e0/report.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
